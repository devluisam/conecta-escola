# ============================================================
# Conecta Escola — variáveis de ambiente
# Copie para .env.local. Sem as variáveis do Supabase, o app
# roda em MODO DEMONSTRAÇÃO (dados fictícios no navegador).
# ============================================================

# --- Supabase (Project Settings > API) ---
# URL e chave pública (anon). São públicas por design: a segurança vem do RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço: SOMENTE no servidor (nunca use o prefixo NEXT_PUBLIC_).
# Usada para o admin cadastrar logins (/api/admin/users) e pelo npm run db:seed.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modo de execução ---
# "demo" força o modo demonstração mesmo com Supabase configurado.
# Deixe vazio (ou "supabase") para usar o banco real quando houver credenciais.
NEXT_PUBLIC_APP_MODE=
